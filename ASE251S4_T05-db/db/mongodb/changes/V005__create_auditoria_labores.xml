<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:mongodb="http://www.liquibase.org/xml/ns/mongodb"
 xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd http://www.liquibase.org/xml/ns/mongodb https://www.liquibase.org/xml/ns/mongodb/liquibase-mongodb-latest.xsd">
  <changeSet id="V005" author="ana-felix">
    <comment>Crear colección de auditoría de labores agrícolas y trazabilidad de cambios en Agro Pacayales S.A.C.</comment>
    <mongodb:createCollection collectionName="auditoria_labores">
      <mongodb:options><![CDATA[{
        "validator": {"$jsonSchema": {
          "bsonType": "object",
          "required": ["entidad", "accion", "usuario", "detalles"],
          "properties": {
            "entidad": {"bsonType": "string"},
            "accion": {"bsonType": "string"},
            "usuario": {"bsonType": "string"},
            "detalles": {"bsonType": "string"},
            "timestamp": {"bsonType": "date"}
          }
        }},
        "validationLevel": "strict",
        "validationAction": "error"
      }]]></mongodb:options>
    </mongodb:createCollection>
    <mongodb:createIndex collectionName="auditoria_labores">
      <mongodb:keys>{"entidad": 1}</mongodb:keys>
      <mongodb:options>{"name": "idx_auditoria_entidad"}</mongodb:options>
    </mongodb:createIndex>
    <rollback><mongodb:dropCollection collectionName="auditoria_labores"/></rollback>
  </changeSet>
</databaseChangeLog>
