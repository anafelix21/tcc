# Copia este archivo como .env. Nunca confirmes .env en Git.
IMAGE_NAMESPACE=hugo454
LAB_VERSION=local

# Microsoft SQL Server 2022 (Docker local o Amazon RDS)
SQL_HOST=localhost
SQL_PORT=1433
SQL_DATABASE=agropacayales_db
SQL_USERNAME=sa
SQL_PASSWORD=AgroPacayales2026!
SQLSERVER_URL=jdbc:sqlserver://localhost:1433;databaseName=agropacayales_db;encrypt=true;trustServerCertificate=true
CHECK_SQLSERVER_URL=r2dbc:sqlserver://localhost:1433/agropacayales_db

# MongoDB Atlas (Conexión Directa a la Nube)
MONGODB_URL=mongodb+srv://HOST/agropacayales_db?appName=Cluster0&tls=true&connectTimeoutMS=10000&serverSelectionTimeoutMS=10000
MONGODB_USERNAME=REEMPLAZAR
MONGODB_PASSWORD=REEMPLAZAR
MONGODB_DATABASE=agropacayales_db
MONGODB_AUTH_DATABASE=admin

CHECKER_PORT=8080
