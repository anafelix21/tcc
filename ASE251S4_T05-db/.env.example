# Copia este archivo como .env. Nunca confirmes .env en Git.
IMAGE_NAMESPACE=hugo454
LAB_VERSION=local

# Aiven PostgreSQL. sslmode=require cifra la conexión usando la CA pública del servicio.
POSTGRES_URL=jdbc:postgresql://HOST:PUERTO/defaultdb?sslmode=require&connectTimeout=10&socketTimeout=30
POSTGRES_USERNAME=REEMPLAZAR
POSTGRES_PASSWORD=REEMPLAZAR
# El checker usa R2DBC y el mismo destino con credenciales separadas.
CHECK_POSTGRES_URL=r2dbc:postgresql://HOST:PUERTO/defaultdb?sslMode=require

# MongoDB Atlas. Las credenciales se entregan por separado a Liquibase.
MONGODB_URL=mongodb+srv://HOST/agropacayales_db?appName=Cluster0&tls=true&connectTimeoutMS=10000&serverSelectionTimeoutMS=10000
MONGODB_USERNAME=REEMPLAZAR
MONGODB_PASSWORD=REEMPLAZAR
MONGODB_DATABASE=agropacayales_db
MONGODB_AUTH_DATABASE=admin

CHECKER_PORT=8080
