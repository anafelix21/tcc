# URLs de los backends para la app móvil AgroPacayales
#
# Opción A: Despliegue en AWS K3s (Reemplazar con la IP pública de tu instancia EC2):
# EXPO_PUBLIC_API_URL=http://<IP_PUBLICA_AWS>:30001/api
# EXPO_PUBLIC_ANALYTICS_URL=http://<IP_PUBLICA_AWS>:30002/api/v1/analytics
#
# Opción B: Ejecución local en tu red Wi-Fi / LAN (Reemplazar con ipconfig):
EXPO_PUBLIC_API_URL=http://192.168.1.10:8081/api
EXPO_PUBLIC_ANALYTICS_URL=http://192.168.1.10:5000/api/v1/analytics
